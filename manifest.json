{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "1.14.4",
  "description": "__MSG_extDescription__",
  "minimum_chrome_version": "116",
  "permissions": [
    "storage",
    "offscreen"
  ],
  "host_permissions": [
    "https://www.skroutz.gr/*",
    "https://www.bestprice.gr/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Eksipno Kalathi",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.skroutz.gr/*",
        "https://www.bestprice.gr/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "default_locale": "en",
  "background": {
    "service_worker": "background.js"
  }
}
